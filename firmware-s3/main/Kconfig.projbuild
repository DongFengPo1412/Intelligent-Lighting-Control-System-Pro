menu "Kurisu Pro Audio Configuration"

    choice AUDIO_MIC_SHIFT
        prompt "INMP441 Microphone Bit Shift & Gain"
        default AUDIO_MIC_SHIFT_16
        help
            Select bit shift applied to INMP441 24-bit I2S data in 32-bit slot.

        config AUDIO_MIC_SHIFT_16
            bool "16-bit shift (Clean, Zero Clipping, Baseline Recommended)"
            help
                Preserves clean dynamic range without digital clipping.

        config AUDIO_MIC_SHIFT_12
            bool "12-bit shift (+24dB High Sensitivity, Mid Compatibility)"
            help
                +24dB amplification for distant speech. Warning: close loud speech may saturate.
    endchoice

    config AUDIO_ENABLE_AFE
        bool "Enable Mid-tier ESP-SR AFE Front-end Processing"
        default y
        help
            Enables ESP-SR Audio Front-End (AFE) pipeline with Noise Suppression and AGC.

endmenu
