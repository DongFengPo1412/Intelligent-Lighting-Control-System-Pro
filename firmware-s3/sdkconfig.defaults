CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_16mb.csv"
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Full 256-pixel canvas commands exceed a 1500-byte Ethernet MTU once wrapped
# for acknowledged UDP delivery. Accept their IPv4 fragments before parsing.
CONFIG_LWIP_IP4_REASSEMBLY=y
CONFIG_AUDIO_MIC_SHIFT_16=y
CONFIG_AUDIO_ENABLE_AFE=y
